{
  "id": "lead-state-consistency-after-each-turn",
  "source": "production-regression-2026-07-24-to-2026-07-26",
  "tags": [
    "state",
    "score",
    "phase",
    "intent",
    "regression"
  ],
  "lang": "es",
  "liveRuns": 3,
  "mockPricing": {
    "planId": "2d1n_mining",
    "individual": 550000,
    "couple": 1000000
  },
  "seedSystem": {
    "dynamicSkillAvailable": true,
    "dynamicSkillRequired": true,
    "reservationPolicy": {
      "depositPercent": 15,
      "securePaymentLinkAvailable": true,
      "reschedulingAllowed": true
    }
  },
  "criteria": [
    {
      "id": "pricing-phase-after-price",
      "rule": "output_flag_equals",
      "flag": "salesPhase",
      "expected": "pricing",
      "turn": 2,
      "weight": 1,
      "critical": true
    },
    {
      "id": "intent-not-curious-after-explicit-reservation",
      "rule": "output_flag_not_equals",
      "flag": "intent",
      "expected": "curious",
      "turn": 3,
      "weight": 1,
      "critical": true
    },
    {
      "id": "reservation-ready-after-explicit-intent",
      "rule": "output_flag_equals",
      "flag": "reservationReady",
      "expected": true,
      "turn": 3,
      "weight": 1,
      "critical": true
    }
  ],
  "turns": [
    {
      "user": "Somos dos personas para el 15 de agosto.",
      "seedQualification": {
        "people": 2,
        "plan": "2d1n_mining",
        "date": "15 de agosto"
      },
      "mockReply": "Perfecto, anoto dos personas para el 15 de agosto.",
      "expect": {
        "shouldSendReply": true
      }
    },
    {
      "user": "¿Cuál es el precio?",
      "mockReply": "El total para dos personas es $1.000.000 COP.",
      "expect": {
        "shouldSendReply": true,
        "salesPhase": "pricing"
      }
    },
    {
      "user": "Me sirve, quiero reservar.",
      "mockReply": "Perfecto. Vamos a iniciar la reserva para el 15 de agosto.",
      "expect": {
        "shouldSendReply": true,
        "intent": "reservation",
        "reservationReady": true
      }
    }
  ]
}
