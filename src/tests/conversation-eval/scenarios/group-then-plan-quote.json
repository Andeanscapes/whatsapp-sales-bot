{
  "id": "group-then-plan-quote",
  "source": "couple → all available Chivor options → plan → quote; three-option presentation supersedes the old binary diagnosis",
  "tags": ["qualification", "live"],
  "lang": "es",
  "liveRuns": 1,
  "minLiveScore": 80,
  "mockPricing": { "planId": "core_2d1n_chivor", "individual": 650000, "couple": 1200000 },
  "criteria": [
    { "id": "all-options-after-group", "rule": "reply_must_match", "patterns": ["BASIC", "CORE", "PRIME"], "turn": 1, "weight": 2, "critical": true },
    { "id": "no-intensity-framing", "rule": "reply_must_not_match", "patterns": ["intens|tranquil|relaj|calma"], "turn": 1, "weight": 2, "critical": true },
    { "id": "no-price-before-choice", "rule": "reply_must_not_match", "patterns": ["\\$|\\bCOP\\b"], "turn": 1, "weight": 2, "critical": true },
    { "id": "plan-after-diagnosis", "rule": "reply_must_match", "patterns": ["plan|d[ií]as|noche"], "turn": 2, "weight": 2, "critical": true },
    { "id": "price-after-fields", "rule": "price_after_min_fields", "minFields": 1, "weight": 2, "critical": true },
    { "id": "couple-total-exact", "rule": "reply_must_match", "patterns": ["1[.,]200[.,]000"], "turn": 3, "weight": 2, "critical": true },
    { "id": "no-wrong-couple-total", "rule": "reply_must_not_match", "patterns": ["1[.,]300[.,]000|2[.,]400[.,]000"], "turn": 3, "weight": 2, "critical": true },
    { "id": "no-reask-group", "rule": "known_field_not_reasked", "field": "people", "suppliedTurn": 1, "weight": 1, "critical": true },
    { "id": "one-question", "rule": "max_question_marks", "max": 1, "turn": 4, "weight": 1 }
  ],
  "turns": [
    { "user": "Pareja", "mockReply": "Tenemos BASIC pasadía sin noche, CORE con una mina y noche, y PRIME con dos minas y cabalgata. ¿Cuál les encaja más?", "expect": { "shouldSendReply": true }, "seedQualification": { "people": 2 } },
    { "user": "El CORE", "mockReply": "El plan CORE es la experiencia esencial: una mina real y caminata guiada. ¿Qué fecha tienen en mente?", "expect": { "shouldSendReply": true }, "seedQualification": { "people": 2, "plan": "core_2d1n_chivor" } },
    { "user": "Cuánto vale?", "mockReply": "Buena elección. Para ustedes dos el valor es de $1.200.000 COP, todo incluido. ¿Qué fecha tienen en mente?", "expect": { "shouldSendReply": true }, "seedQualification": { "people": 2, "plan": "core_2d1n_chivor" } },
    { "user": "En agosto, el segundo fin de semana", "mockReply": "Perfecto. El siguiente paso es validar esa fecha con el equipo para asegurar el cupo. ¿Quieres que la confirme?", "expect": { "shouldSendReply": true }, "seedQualification": { "people": 2, "plan": "core_2d1n_chivor", "date": "agosto" } }
  ]
}
