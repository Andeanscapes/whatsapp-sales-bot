    { "id": "no-reask-group", "rule": "known_field_not_reasked", "field": "people", "suppliedTurn": 1, "weight": 1, "critical": true },
     { "id": "one-question", "rule": "max_question_marks", "max": 1, "turn": 2, "weight": 1 },
     { "id": "no-emoji-on-quote", "rule": "max_emojis", "max": 0, "turn": 2, "weight": 1 }
  ],
  "turns": [
    { "user": "Somos 5", "mockReply": "Perfecto, para 5 personas reviso el precio exacto según el plan. ¿Cuál duración les interesa?", "expect": { "shouldSendReply": true }, "seedQualification": { "people": 5 } },
    { "user": "El de 2 días", "mockReply": "Para 5 personas, el valor exacto sería $2.250.000 COP según la fórmula publicada. ¿Qué fecha tienen en mente?", "expect": { "shouldSendReply": true }, "seedQualification": { "people": 5, "plan": "2d1n_mining" } }
  ]
}
