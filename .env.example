# App
APP_VERSION=1.0
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
STARTUP_DIAGNOSTICS_ENABLED=false
# Dev safety switch: when true, process WhatsApp inbound only from OWNER_PERSONAL_WHATSAPP_NUMBER.
# Keep false in production.
WEBHOOK_OWNER_ONLY_ENABLED=false
PUBLIC_BASE_URL=https://bot.yourdomain.com
PUBLIC_TOUR_URL=https://your-public-site.com/experiences/emerald-mining-tour

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
WHATSAPP_GRAPH_API_VERSION=v24.0

# Owner identity (used in skill files + system prompt via {{OWNER_NAME}} / {{PARTNER_NAME}} substitution)
OWNER_NAME=change-me
PARTNER_NAME=change-me

# Owner alert
OWNER_PERSONAL_WHATSAPP_NUMBER=573000000000
ALERT_CHANNEL=telegram
HOT_LEAD_THRESHOLD=85
URGENT_LEAD_THRESHOLD=95
MAX_OWNER_WHATSAPP_ALERTS_PER_CUSTOMER_PER_DAY=1

# Telegram optional low-cost alert
TELEGRAM_BOT_TOKEN=
# Fallback Telegram chat used ONLY when LEAD_ROUTING_JSON is empty (single-line mode).
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING_ENABLED=true
# Extra phone numbers to exclude from reports (/summary, /stats, /recent), comma-separated.
# OWNER_PERSONAL_WHATSAPP_NUMBER is always excluded automatically — no need to list it here.
REPORT_EXCLUDED_PHONES=

# Multi-line lead routing (optional). Leave empty for single-line mode.
# Hot-lead alerts and conversation access are scoped per sales line:
#   - "weight" = relative split of hot leads (sticky per customer, normalized).
#                NOTE: when BRIDGE_FLOW (below) is set to 0-100, these weights are
#                overridden — BRIDGE_FLOW controls the bridge vs referral split and
#                the per-group "weight" values only set proportions within each group.
#   - "type=bridge"   -> agent replies through the API line via Telegram (/chat).
#                        Use the API line (WHATSAPP_PHONE_NUMBER_ID above).
#   - "type=referral" -> bot tells the customer the agent will contact them from
#                        "displayNumber"; that agent replies from their own
#                        WhatsApp Business app (not the bridge).
#   - "telegramChatId" must be UNIQUE per line; an agent only sees alerts +
#                        conversations for their own assigned leads. /report counts
#                        are global (all lines) and visible to every agent.
# {{OWNER_NAME}} / {{PARTNER_NAME}} are substituted from the env vars above.
#
# Example: line 1 = your API line (bridge, 30%); line 2 = partner referral (70%):
# LEAD_ROUTING_JSON={"salesLines":[{"id":"line1_bridge","type":"bridge","label":"ANDEAN SCAPES BOOKING","weight":30,"telegramChatId":"111111111","agentName":"{{OWNER_NAME}}"},{"id":"line2_referral","type":"referral","label":"ANDEAN SCAPES BOOKING","weight":70,"displayNumber":"+573001112233","telegramChatId":"222222222","agentName":"{{PARTNER_NAME}}"}]}
LEAD_ROUTING_JSON=

# Override the percentage of leads routed to bridge lines (0-100).
# The remaining percentage is split proportionally across referral lines.
# Set to -1 (default) to use raw weights from LEAD_ROUTING_JSON instead.
# Example: BRIDGE_FLOW=70 sends ~70% of new leads to bridge, 30% to referral lines.
BRIDGE_FLOW=-1
# Minimum hybrid lead score (0-100) required, together with analyzer-confirmed
# booking readiness, before the bot bridges/alerts the owner.
BRIDGE_SCORE_THRESHOLD=75

# DeepSeek optional fallback
AI_ENABLED=true
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=800
DEEPSEEK_CONTEXT_WINDOW_TOKENS=65536
DEEPSEEK_HISTORY_MAX_CHARS=12000
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_INPUT_COST_PER_MILLION_USD=0.15
DEEPSEEK_OUTPUT_COST_PER_MILLION_USD=0.60

# AI budget controls
DAILY_AI_BUDGET_USD=2.00
MONTHLY_AI_BUDGET_USD=30.00
MAX_AI_CALLS_PER_CUSTOMER_PER_DAY=30
MAX_AI_CALLS_GLOBAL_PER_DAY=1500
AI_CACHE_TTL_SECONDS=604800

# WhatsApp cost controls
SEND_IMAGES_ENABLED=true
MEDIA_MARKER_RETRY_ENABLED=true
# Human-like reply pacing (first msg 10-40s, burst 1-4s). false for dev/CI; set true in prod (/etc/andean-whatsapp-bot.env or .env.prod).
MESSAGE_DELAY=false
MAX_GALLERY_IMAGES_PER_SEND=3
MAX_GALLERY_IMAGES_PER_CUSTOMER_PER_HOUR=45
MAX_GALLERY_IMAGES_PER_CUSTOMER_PER_DAY=150
# Gallery images have their own caps; image rows do not consume text-message limits.
# One themed gallery photo carrying the reply as its caption (turn 2+), matched
# from feed-defined reply keywords and narrowed by the entry-segment mapping.
# Requires media.types, media.typeKeywords, and a `type` on each gallery image.
# Cadence counts contextual sends only — the plan image does not suppress these.
CONTEXTUAL_IMAGES_ENABLED=false
# Minutes between photos in one chat (conversational cadence, fractional allowed).
CONTEXTUAL_IMAGES_MIN_GAP_MINUTES=3
# Real ceiling: photos per customer per 72h.
CONTEXTUAL_IMAGES_MAX_PER_72H=6
# Fraction (0-1) of theme-matching turns that actually send an image. Sub-1 makes
# cadence unpredictable (human-like) instead of firing on every eligible turn.
# Tune against your own feed: the chance of a conversation with ZERO photos is
# (1 - p) ^ (number of theme-matching turns), so a low p plus few matching turns
# silently disables the feature. Starting point, not a measured optimum.
CONTEXTUAL_IMAGES_PROBABILITY=0.6
MAX_BOT_MESSAGES_PER_CUSTOMER_PER_HOUR=50
MAX_BOT_MESSAGES_PER_CUSTOMER_PER_DAY=120

# Post-24h follow-up template (one-shot per customer, operator-granted consent, no LLM)
# Requires the template to be APPROVED in WhatsApp Manager first.
# This is the switch that authorises real Meta template sends.
ALLOW_FOLLOWUP_TEMPLATE=false
# ES and EN are SEPARATE approved templates, so each has its own name. English
# leads are skipped (no send, no Meta error) while _EN is empty.
FOLLOWUP_TEMPLATE_NAME=tour_followup_nodate_v1
FOLLOWUP_TEMPLATE_NAME_EN=
# `image` = approved template has a REQUIRED image header. The send is SKIPPED when
# no public HTTPS image resolves from the dynamic feed, because Meta rejects a
# missing required header with (#132000). Use `none` only for header-less templates.
FOLLOWUP_TEMPLATE_HEADER=image
# Hours of silence after the customer's last inbound before the single template.
FOLLOWUP_HOURS_AFTER_INBOUND=24
FOLLOWUP_POLL_MS=60000
# Max send attempts per silence anchor. Prevents a terminally rejected template
# (e.g. #132000) from retrying on every tick forever.
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_MAX_SENDS_PER_TICK=25
# Minutes a pending claim may sit before another tick reclaims it after a crash.
FOLLOWUP_CLAIM_STALE_MINUTES=10
# Dev-only accelerator: >0 waits N minutes instead of FOLLOWUP_HOURS_AFTER_INBOUND.
# Set to 2 for local testing. Startup FAILS if this is >0 when NODE_ENV=production.
FOLLOWUP_DEV_MINUTES=0
# Dev-only allowlist (comma-separated). Empty = every eligible lead.
# Startup FAILS if this is non-empty when NODE_ENV=production.
FOLLOWUP_DEV_ALLOWLIST_PHONES=

# --- Stage 1: consent ask (free-form, LLM-written, inside the 24h window) ---
# SEPARATE switch from ALLOW_FOLLOWUP_TEMPLATE above and FOLLOWUP_RECURRING_ENABLED
# below. Never alias the three: each authorises a different outbound path.
FOLLOWUP_CONSENT_ASK_ENABLED=false
# Hours after the CUSTOMER's last inbound. Hard-capped at 23: Meta's 24h window is
# measured from the customer's message, so a larger value sends outside the window.
# 18 (not 23) because eligibility ALSO requires the window to still be open, so 23
# left only a ~50 minute slot per customer; 18 gives ~5h50m.
FOLLOWUP_CONSENT_HOURS_AFTER_INBOUND=18
# Dev-only: SECONDS instead of hours. Startup FAILS if >0 when NODE_ENV=production.
FOLLOWUP_DEV_CONSENT_SECONDS=0
# Gallery theme whose photo carries the consent ask as its caption (e.g. `mine`).
# Must be a type declared in the feed's `media.types`; an unknown type or a feed
# with no photo of that type falls back to plain text. Empty = plain text.
FOLLOWUP_CONSENT_ASK_IMAGE_TYPE=
# Seconds after consent activates during which a repeated bare "si" does NOT close
# the consent cycle. Customers double-tap send; without this the echo revokes the
# permission granted a moment earlier. Only exact bare affirmations qualify — any
# message carrying intent still closes the cycle. 0 disables.
FOLLOWUP_CONSENT_DUPLICATE_GRACE_SECONDS=120
# Gallery theme for the approved-template HEADER image (one-shot + recurring).
# A random photo of this theme is preferred over the plan brochure card so repeat
# templates do not always show the same image; rotation is bounded by the 72h
# media_sends record. Falls back to the plan card, then the owner photo.
FOLLOWUP_TEMPLATE_IMAGE_TYPE=

# --- Stages 3-4: recurring approved template (allowed OUTSIDE the 24h window) ---
# Only sends to customers whose subscription status is 'active' (they said yes).
FOLLOWUP_RECURRING_ENABLED=false
# First production send after 1 month; later gaps multiply by 3: 3, 9, 27… months.
FOLLOWUP_RECURRING_INTERVAL_MONTHS=1
# Dev-only: SECONDS instead of months. Startup FAILS if >0 when NODE_ENV=production.
FOLLOWUP_DEV_RECURRING_SECONDS=0
# Required when FOLLOWUP_RECURRING_ENABLED=true (env validation enforces it).
FOLLOWUP_RECURRING_TEMPLATE_NAME=tour_followup_nodate_v1
FOLLOWUP_RECURRING_TEMPLATE_NAME_EN=
FOLLOWUP_RECURRING_TEMPLATE_HEADER=image
# Total recurring sends per consent cycle. 0 = unbounded (not recommended:
# repeating identical copy raises block/report risk and lowers WABA quality rating).
FOLLOWUP_MAX_RECURRING_SENDS=12
# Absolute silence floor before ANY recurring template, measured from the customer's
# last inbound and INDEPENDENT of the cadence interval above. Prevents a template
# landing shortly after a live conversation even if the cadence is short.
FOLLOWUP_RECURRING_MIN_SILENCE_HOURS=72
# Dev-only: SECONDS instead of hours for that floor. Keep it comfortably ABOVE
# FOLLOWUP_DEV_RECURRING_SECONDS so local tests still show the dormancy rule.
# Startup FAILS if >0 when NODE_ENV=production.
FOLLOWUP_DEV_RECURRING_MIN_SILENCE_SECONDS=0

# SQLite
SQLITE_PATH=./data/bot.sqlite

# Dynamic pricing & availability (Cloudflare R2)
# Leave empty to use static defaults from andean-scapes.skill.json
# Public JSON must NEVER include payment phone numbers, links, or transfer instructions.
DYNAMIC_SKILL_URL=
# How often to re-fetch from R2 (milliseconds). Default: 5000
DYNAMIC_SKILL_REFRESH_MS=5000

# Mercado Pago Checkout Pro (leave blank until payment integration is enabled)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=info

# Operator-only daily follow-up digest (Telegram, owner chat).
# Reads state and reports; it never messages a customer, so it is NOT a fourth
# outbound path. FOLLOWUP_DIGEST_DEV_FORCE sends one at boot and is rejected in
# production, where it would fire on every deploy.
FOLLOWUP_DIGEST_ENABLED=false
FOLLOWUP_DIGEST_HOUR_BOGOTA=8
FOLLOWUP_DIGEST_DEV_FORCE=false
