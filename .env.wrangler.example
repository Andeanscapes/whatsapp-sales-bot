# Cloudflare credentials for `npm run media:push` and `npm run dynamic:push`.
# Copy to `.env.wrangler` (gitignored). Never commit real values.

# Token with R2 write on andean-app-dev. Reuse the andean_v3 token.
CLOUDFLARE_API_TOKEN=

# Required by wrangler when the token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=

# Optional. Needed for the best-effort CDN cache purge after an upload.
# The token also needs `Zone · Cache Purge · Purge` on that zone.
CLOUDFLARE_ZONE_ID=

# Optional. Only andean-app-dev is supported by the fixed CDN read/backup target.
# R2_BUCKET=andean-app-dev
